# Build configuration. Edit, then run ./build.sh
# Everything here ends up visible to the guest; change the values so your
# build does not share a fingerprint with everyone else using this kit.

# --- pinned upstream sources (official Proxmox git) -------------------------
PVE_GIT=https://git.proxmox.com/git
PVE_QEMU_COMMIT=242e15da9cbdf3e5b64f0ea9a4719dca99a0f2c3   # pve-qemu 11.1.3-4
PVE_EDK2_COMMIT=f37039e52d228a7844a90aa2aaf1e161ebd04fcd   # pve-edk2-firmware 4.2026.08-1

# --- identity source ----------------------------------------------------------
# Strong-real is the clean default: SMBIOS type 4 must equal this host's CPU.
# "model" is only the Strong-skin generator skeleton; it does not spoof MSRs,
# TSC, PMU or CPUID feature state and never changes the baseline kvm.ko.
CPU_SOURCE=host

# --- identity strings ---------------------------------------------------------
brand="DELL"                 # 4 upper-case letters, replaces "QEMU" in device strings
brand_edk2="Dell"           # brand used in OVMF module names (author used mixed case)
IDE_FW_REV="RVT04B6Q"        # fallback only; configvm sets a per-disk revision
SCSI_FW_REV="1.00"           # SCSI firmware/revision (4 chars max)
POH=3127                     # SMART power-on hours
PCC=412                      # SMART power-cycle count
SAS_ADDR=5000c500a1b2c3d4    # LSI MPT SAS address (16 hex digits)
USB_HUB_SERIAL=280512        # USB hub serial (6 digits)
USB_NET_MAC=40a2b3c4d5e6     # usb-net default MAC (12 hex digits)
SMBIOS_T1_VERSION="1.0"      # SMBIOS type 1 version when not set via -smbios

# --- optional features ---------------------------------------------------------
# Rebrand PCI vendor IDs of stdvga (0x1234), virtio (0x1af4) and vmware-svga (0x15ad)
# in QEMU *and* OVMF, as found in the author's closed "Strong" OVMF build.
# Breaks stock virtio drivers in the guest. 0 = off, 1 = on.
STRONG_PCI_IDS=0
STDVGA_VENDOR=0x6666
VIRTIO_VENDOR=0x8085

# SMBIOS memory + socket profile (type 17 / type 4). The author's defaults describe DDR3-1600
# SODIMM on an LGA1700 socket, which is inconsistent (DDR3 + laptop form factor on a desktop
# DDR4/DDR5 board) and detectable. Defaults below are a consistent DDR4-3200 desktop DIMM;
# make them match the board you present in the VM's -smbios args.
# memory_type: DDR3=0x18 DDR4=0x1a DDR5=0x22 ; form_factor: DIMM=0x09 SODIMM=0x0d
MEM_TYPE_HEX=0x1a
MEM_FORM_FACTOR_HEX=0x09
MEM_SPEED=3200
MEM_VENDOR="Kingston"
MEM_PART="KF432C16BB/16"
MEM_VMIN=1200      # DDR4 = 1.20 V
MEM_VMAX=1200
MEM_VCFG=1200
MEM_ERROR_CORRECTION_HEX=0x03  # 0x03 none for desktop; 0x06 multi-bit ECC for RDIMM
MEM_TYPE_DETAIL_HEX=0x0002     # 0x0080 for registered RDIMM
CPU_SOCKET="LGA1700"

# Host CPU sensor passthrough (Intel only): let the guest read the host's thermal,
# performance-status AND RAPL energy MSRs, so monitoring tools (HWiNFO, CPU-Z) show real
# values and the guest's RAPL (powercap) driver binds. This is an open reimplementation of
# the closed "Strong" sensor feature (whose source the author does not publish); it does NOT
# reproduce the author's closed kvm.ko. Add host-sensors=on to the VM's -cpu. Requires the
# host "msr" kernel module. On a multi-socket host the per-package RAPL counters can step if
# a vCPU floats across sockets; pin the VM to one socket. Do NOT also pass
# -accel kvm,rapl=on (the upstream qemu-vmsr-helper): pick one RAPL path, not both. See the
# RAPL note in README. 0 = off, 1 = on.
HOST_SENSORS=0

# Replace QEMU's default PCI subsystem IDs (0x1af4 Red Hat / 0x1100 QEMU) on devices that use
# the default (ich9/SATA/USB/audio...) with a real board maker's ids. 0 = off, 1 = on.
# Pick SUBSYS_VENDOR_HEX to match the board you present: ASUS 0x1043, Gigabyte 0x1458,
# MSI 0x1462, Dell 0x1028, HP 0x103c, Lenovo 0x17aa, Intel 0x8086. (gen-profile.py sets it.)
STRONG_SUBSYS_IDS=0
SUBSYS_VENDOR_HEX=0x1043
SUBSYS_DEVICE_HEX=0x8694

# Experimental identity-only re-skins. Both default off. Enabling either requires successful
# OVMF and SeaBIOS boot tests; it does not emulate a physical chipset or bus protocol.
STRONG_FW_CFG=0
FW_CFG_BRAND="ASUS"
FW_CFG_SIGNATURE_HEX=0x4155535520434647
FW_CFG_ACPI_ID="ASUS0002"
STRONG_HOST_BRIDGE=0
HOST_BRIDGE_DEVICE=0x9b43  # example only; use the imported physical host-bridge ID
HOST_BRIDGE_EVIDENCE_SHA256=""  # lspci_sha256 from the matching chipset-map record

# Build SeaBIOS from source with the author's (published) anti-detection patch
BUILD_SEABIOS=1
SEABIOS_VERSION="1.17.0"     # version string reported by SeaBIOS (stock: "...-prebuilt.qemu.org")

# UEFI firmware vendor/version reported by OVMF. Proxmox (and the author's builds) report
# "Proxmox distribution of EDK II" / "4.2026.08-1". Set OVMF_FW_VENDOR="" to keep that.
OVMF_FW_VENDOR="American Megatrends"
OVMF_FW_VERSION="5.27"

# OVMF boot logo: path to your own 24-bit BMP, or empty = generate a plain black one
LOGO_BMP=""
# SeaBIOS boot splash: path to a JPEG to force as splash (author did this), or empty = off
BOOTSPLASH_JPG=""
# Author's IGD passthrough tweak in hw/vfio/igd.c (inverts the LPC-bridge type check)
IGD_LPC_HACK=1

# EXPERIMENTAL, off by default. Build the open kvm.ko (kernel/build-kvm.sh) with an opt-in
# CPUID-VM-exit jitter hook. It stays inert until you set the realpc_cpuid_jitter module
# parameter at runtime, and even then it only raises the VARIANCE of the cpuid VM-exit (to
# fool naive low-variance detectors) — it does NOT lower the median, so a median-based
# detector still sees the VM-exit, and it adds latency to every CPUID. Measure the trade-off
# with tests/timing_tests/jitter_report.py before enabling. 0 = off, 1 = build the hook in.
VM_EXIT_JITTER=0
