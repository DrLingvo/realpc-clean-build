# Build-time profile overrides. Merge into config.env and rebuild QEMU ONLY if
# the memory type/form factor below differ from your current build.
MEM_TYPE_HEX=0x22
MEM_FORM_FACTOR_HEX=0x09
MEM_SPEED=5600
MEM_VENDOR=Corsair
MEM_PART=CMK32GX5M2B5600C36
MEM_VMIN=1100
MEM_VMAX=1100
MEM_VCFG=1100
CPU_SOCKET=AM5
IDE_SERIAL_PREFIX=Z9ANES6L
