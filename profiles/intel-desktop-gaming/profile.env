# Build-time profile overrides. Merge into config.env and rebuild QEMU if the
# memory type/form factor below differ from your build, or to apply the subsystem
# ids (those need STRONG_SUBSYS_IDS=1 in config.env).
MEM_TYPE_HEX=0x1a
MEM_FORM_FACTOR_HEX=0x09
MEM_SPEED=3200
MEM_VENDOR=Kingston
MEM_PART=KF432C16BB/16
MEM_VMIN=1200
MEM_VMAX=1200
MEM_VCFG=1200
CPU_SOCKET=LGA1700
IDE_SERIAL_PREFIX=50026BSG
SUBSYS_VENDOR_HEX=0x1043
SUBSYS_DEVICE_HEX=0x80e7
