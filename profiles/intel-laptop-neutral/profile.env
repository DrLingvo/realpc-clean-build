# Build-time profile overrides. Merge into config.env and rebuild QEMU if the
# memory type/form factor below differ from your build, or to apply the subsystem
# ids (those need STRONG_SUBSYS_IDS=1 in config.env).
MEM_TYPE_HEX=0x22
MEM_FORM_FACTOR_HEX=0x0d
MEM_SPEED=4800
MEM_VENDOR=Samsung
MEM_PART=M425R2GA3BB0-CQK
MEM_VMIN=1100
MEM_VMAX=1100
MEM_VCFG=1100
CPU_SOCKET=BGA1744
IDE_SERIAL_PREFIX=S6Z1NGE4
SUBSYS_VENDOR_HEX=0x103c
SUBSYS_DEVICE_HEX=0x8c4a
