+/*
+ * host-sensors: pass the host's thermal and performance-status MSRs through to
+ * the guest. Reads are served from /dev/cpu/N/msr of the host CPU the vCPU
+ * thread is running on at that moment (needs the "msr" kernel module and
+ * permission to read it; QEMU runs as root on Proxmox VE). Writes are ignored.
+ * Only a fixed list of read-only sensor MSRs is exposed.
+ */
+static int *host_sensor_msr_fds;
+static int host_sensor_ncpus;
+static QemuMutex host_sensor_lock;
+
+static int host_sensor_fd(int hcpu)
+{
+    int fd;
+
+    if (hcpu < 0 || hcpu >= host_sensor_ncpus) {
+        return -1;
+    }
+    fd = qatomic_read(&host_sensor_msr_fds[hcpu]);
+    if (fd != -2) {
+        return fd;
+    }
+    qemu_mutex_lock(&host_sensor_lock);
+    fd = host_sensor_msr_fds[hcpu];
+    if (fd == -2) {
+        g_autofree char *path = g_strdup_printf("/dev/cpu/%d/msr", hcpu);
+        fd = open(path, O_RDONLY | O_CLOEXEC);
+        if (fd < 0) {
+            warn_report_once("host-sensors: cannot open %s: %s "
+                             "(is the msr module loaded?)",
+                             path, strerror(errno));
+        }
+        qatomic_set(&host_sensor_msr_fds[hcpu], fd);
+    }
+    qemu_mutex_unlock(&host_sensor_lock);
+    return fd;
+}
+
+static bool kvm_rdmsr_host_sensor(X86CPU *cpu, uint32_t msr, uint64_t *val)
+{
+    int fd = host_sensor_fd(sched_getcpu());
+
+    *val = 0;
+    if (fd >= 0 && pread(fd, val, sizeof(*val), msr) != sizeof(*val)) {
+        *val = 0;
+    }
+    /* never inject #GP: monitoring drivers in the guest may not expect it */
+    return true;
+}
+
+static bool kvm_wrmsr_host_sensor(X86CPU *cpu, uint32_t msr, uint64_t val)
+{
+    return true;
+}
+
+static int kvm_enable_host_sensor_msrs(KVMState *s)
+{
+    static const uint32_t msrs[] = {
+        MSR_IA32_PERF_STATUS_HS,
+        MSR_IA32_THERM_STATUS_HS,
+        MSR_TEMPERATURE_TARGET_HS,
+        MSR_IA32_PACKAGE_THERM_STATUS_HS,
+    };
+    static bool done;
+    int i, ret;
+
+    if (done) {
+        return 0;
+    }
+    if (!is_host_cpu_intel()) {
+        error_report("host-sensors is only supported on Intel hosts");
+        return -ENOTSUP;
+    }
+    if (!kvm_vm_check_extension(s, KVM_CAP_X86_USER_SPACE_MSR)) {
+        error_report("host-sensors needs KVM_CAP_X86_USER_SPACE_MSR");
+        return -ENOTSUP;
+    }
+    host_sensor_ncpus = sysconf(_SC_NPROCESSORS_CONF);
+    if (host_sensor_ncpus <= 0) {
+        return -EINVAL;
+    }
+    host_sensor_msr_fds = g_new(int, host_sensor_ncpus);
+    for (i = 0; i < host_sensor_ncpus; i++) {
+        host_sensor_msr_fds[i] = -2; /* not opened yet */
+    }
+    qemu_mutex_init(&host_sensor_lock);
+
+    for (i = 0; i < ARRAY_SIZE(msrs); i++) {
+        ret = kvm_filter_msr(s, msrs[i], kvm_rdmsr_host_sensor,
+                             kvm_wrmsr_host_sensor);
+        if (ret < 0) {
+            error_report("host-sensors: could not install handler for "
+                         "MSR 0x%x: %s", msrs[i], strerror(-ret));
+            return ret;
+        }
+    }
+    done = true;
+    return 0;
+}
+
 int kvm_arch_init_vcpu(CPUState *cs)
 {
     struct {
@@ -2250,6 +2350,13 @@ int kvm_arch_init_vcpu(CPUState *cs)
         }
     }
 
+    if (cpu->host_sensors) {
+        r = kvm_enable_host_sensor_msrs(cs->kvm_state);
+        if (r < 0) {
+            return r;
+        }
+    }
+
     memset(&cpuid_data, 0, sizeof(cpuid_data));
 
     cpuid_i = 0;
