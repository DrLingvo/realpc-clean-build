diff -urN a/hw/smbios/smbios.c b/hw/smbios/smbios.c
--- a/hw/smbios/smbios.c
+++ b/hw/smbios/smbios.c
@@ -556,6 +556,193 @@
 #define T9_BASE 0x900
 #define T11_BASE 0xe00

+#define T8_BASE 0x800
+#define T7_BASE 0x700
+#define T26_BASE 0x1A00
+#define T27_BASE 0x1B00
+#define T28_BASE 0x1C00
+#define T29_BASE 0x1D00
+#define T39_BASE 0x2700
+
+struct smbios_type_7 {
+    struct smbios_structure_header header;
+    uint8_t socket_designation;
+    uint16_t cache_configuration;
+    uint16_t max_cache_size;
+    uint16_t installed_size;
+    uint16_t supported_sram_type;
+    uint16_t current_sram_type;
+    uint8_t cache_speed;
+    uint8_t error_correction;
+    uint8_t system_cache_type;
+    uint8_t associativity;
+} QEMU_PACKED;
+
+struct smbios_type_26 {
+    struct smbios_structure_header header;
+    uint8_t description;
+    uint8_t location_and_status;
+    uint16_t max_value;
+    uint16_t min_value;
+    uint16_t resolution;
+    uint16_t tolerance;
+    uint16_t accuracy;
+    uint32_t oem_defined;
+    uint16_t nominal_value;
+} QEMU_PACKED;
+
+struct smbios_type_27 {
+    struct smbios_structure_header header;
+    uint16_t temperature_probe_handle;
+    uint8_t device_type_and_status;
+    uint8_t cooling_unit_group;
+    uint32_t OEM_defined;
+    uint16_t nominal_speed;
+    uint8_t description;
+} QEMU_PACKED;
+
+struct smbios_type_28 {
+    struct smbios_structure_header header;
+    uint8_t description;
+    uint8_t location_and_status;
+    uint16_t maximum_value;
+    uint16_t minimum_value;
+    uint16_t resolution;
+    uint16_t tolerance;
+    uint16_t accuracy;
+    uint32_t OEM_defined;
+    uint16_t nominal_value;
+} QEMU_PACKED;
+
+struct smbios_type_29 {
+    struct smbios_structure_header header;
+    uint8_t description;
+    uint8_t location_and_status;
+    uint16_t maximum_value;
+    uint16_t minimum_value;
+    uint16_t resolution;
+    uint16_t tolerance;
+    uint16_t accuracy;
+    uint32_t oem_defined;
+    uint16_t nominal_value;
+} QEMU_PACKED;
+
+struct smbios_type_39 {
+    struct smbios_structure_header header;
+    uint8_t power_unit_group;
+    uint8_t location;
+    uint8_t device_name;
+    uint8_t manufacturer;
+    uint8_t serial_number;
+    uint8_t asset_tag_number;
+    uint8_t model_part_number;
+    uint8_t revision_level;
+    uint16_t max_power_capacity;
+    uint16_t power_supply_characteristics;
+    uint16_t input_voltage_probe_handle;
+    uint16_t cooling_device_handle;
+    uint16_t input_current_probe_handle;
+} QEMU_PACKED;
+
+static void smbios_build_type_7_table(unsigned instance, const char *designation,
+                                      uint16_t configuration, uint16_t size_kb,
+                                      uint8_t correction, uint8_t cache_type,
+                                      uint8_t associativity)
+{
+    SMBIOS_BUILD_TABLE_PRE(7, T7_BASE + instance, true);
+    SMBIOS_TABLE_SET_STR(7, socket_designation, designation);
+    t->cache_configuration = cpu_to_le16(configuration);
+    t->max_cache_size = cpu_to_le16(size_kb);
+    t->installed_size = cpu_to_le16(size_kb);
+    t->supported_sram_type = cpu_to_le16(0x20);
+    t->current_sram_type = cpu_to_le16(0x20);
+    t->cache_speed = 0;
+    t->error_correction = correction;
+    t->system_cache_type = cache_type;
+    t->associativity = associativity;
+    SMBIOS_BUILD_TABLE_POST;
+}
+
+static void smbios_build_type_26_table(unsigned instance, const char *description,
+                                       uint8_t location_and_status)
+{
+    SMBIOS_BUILD_TABLE_PRE(26, T26_BASE + instance, true);
+    SMBIOS_TABLE_SET_STR(26, description, description);
+    t->location_and_status = location_and_status;
+    t->max_value = cpu_to_le16(instance == 0 ? 2000 : 0x8000);
+    t->min_value = cpu_to_le16(instance == 0 ? 0 : 0x8000);
+    t->resolution = cpu_to_le16(instance == 0 ? 10 : 0x8000);
+    t->tolerance = cpu_to_le16(instance == 0 ? 50 : 0x8000);
+    t->accuracy = cpu_to_le16(instance == 0 ? 100 : 0x8000);
+    t->oem_defined = 0;
+    t->nominal_value = cpu_to_le16(instance == 0 ? 1200 : 0x8000);
+    SMBIOS_BUILD_TABLE_POST;
+}
+
+static void smbios_build_type_27_table(unsigned instance, const char *description,
+                                       uint8_t device_type_and_status)
+{
+    SMBIOS_BUILD_TABLE_PRE(27, T27_BASE + instance, true);
+    t->temperature_probe_handle = cpu_to_le16(T28_BASE + instance);
+    t->device_type_and_status = device_type_and_status;
+    t->cooling_unit_group = 1;
+    t->OEM_defined = 0;
+    t->nominal_speed = cpu_to_le16(1500);
+    SMBIOS_TABLE_SET_STR(27, description, description);
+    SMBIOS_BUILD_TABLE_POST;
+}
+
+static void smbios_build_type_28_table(unsigned instance, const char *description,
+                                       uint8_t location_and_status)
+{
+    SMBIOS_BUILD_TABLE_PRE(28, T28_BASE + instance, true);
+    SMBIOS_TABLE_SET_STR(28, description, description);
+    t->location_and_status = location_and_status;
+    t->maximum_value = cpu_to_le16(1000);
+    t->minimum_value = cpu_to_le16(0);
+    t->resolution = cpu_to_le16(1);
+    t->tolerance = cpu_to_le16(10);
+    t->accuracy = cpu_to_le16(100);
+    t->OEM_defined = 0;
+    t->nominal_value = cpu_to_le16(450);
+    SMBIOS_BUILD_TABLE_POST;
+}
+
+static void smbios_build_type_29_table(unsigned instance, const char *description,
+                                       uint8_t location_and_status)
+{
+    SMBIOS_BUILD_TABLE_PRE(29, T29_BASE + instance, true);
+    SMBIOS_TABLE_SET_STR(29, description, description);
+    t->location_and_status = location_and_status;
+    t->maximum_value = cpu_to_le16(10000);
+    t->minimum_value = cpu_to_le16(0);
+    t->resolution = cpu_to_le16(10);
+    t->tolerance = cpu_to_le16(100);
+    t->accuracy = cpu_to_le16(100);
+    t->oem_defined = 0;
+    t->nominal_value = cpu_to_le16(2000);
+    SMBIOS_BUILD_TABLE_POST;
+}
+
+static void smbios_build_type_39_table(void)
+{
+    SMBIOS_BUILD_TABLE_PRE(39, T39_BASE, true);
+    t->power_unit_group = 0;
+    SMBIOS_TABLE_SET_STR(39, location, "Chassis rear");
+    SMBIOS_TABLE_SET_STR(39, device_name, "Desktop PSU");
+    SMBIOS_TABLE_SET_STR(39, manufacturer, "FSP Group");
+    SMBIOS_TABLE_SET_STR(39, serial_number, "PSU0001001");
+    SMBIOS_TABLE_SET_STR(39, asset_tag_number, "PSU-01");
+    SMBIOS_TABLE_SET_STR(39, model_part_number, "FSP650-50EGN");
+    SMBIOS_TABLE_SET_STR(39, revision_level, "1.0");
+    t->max_power_capacity = cpu_to_le16(650);
+    t->power_supply_characteristics = cpu_to_le16(0x19A2);
+    t->input_voltage_probe_handle = cpu_to_le16(T26_BASE + 1);
+    t->cooling_device_handle = cpu_to_le16(T27_BASE + 1);
+    t->input_current_probe_handle = cpu_to_le16(T29_BASE);
+    SMBIOS_BUILD_TABLE_POST;
+}
+
 #define T16_BASE 0x1000
 #define T17_BASE 0x1100
 #define T19_BASE 0x1300
@@ -1129,6 +1316,15 @@
         }
     }

+	unsigned cores_per_socket = machine_topo_get_cores_per_socket(ms);
+	smbios_build_type_7_table(0, "L1 Data Cache", 0x180,
+	                          cores_per_socket * 0x20, 0x04, 0x04, 0x07);
+	smbios_build_type_7_table(1, "L1 Instruction Cache", 0x180,
+	                          cores_per_socket * 0x20, 0x04, 0x03, 0x07);
+	smbios_build_type_7_table(2, "L2 Cache", 0x181,
+	                          cores_per_socket * 0x200, 0x05, 0x05, 0x08);
+	smbios_build_type_7_table(3, "L3 Cache", 0x182,
+	                          0x4000, 0x06, 0x05, 0x08);
     smbios_build_type_8_table();
     smbios_build_type_9_table(errp);
     smbios_build_type_11_table();
@@ -1167,6 +1363,14 @@
      */
     assert((mem_array_size + offset) < (T32_BASE - T19_BASE));

+	smbios_build_type_26_table(0, "CPU Vcore", 0x63);
+	smbios_build_type_26_table(1, "PSU Input Voltage", 0x6A);
+	smbios_build_type_27_table(0, "CPU Fan", 0x63);
+	smbios_build_type_27_table(1, "PSU Fan", 0x67);
+	smbios_build_type_28_table(0, "CPU Temperature", 0x63);
+	smbios_build_type_28_table(1, "System Temperature", 0x67);
+	smbios_build_type_29_table(0, "PSU Input Current", 0x6A);
+	smbios_build_type_39_table();
     smbios_build_type_32_table();
     smbios_build_type_38_table();
     smbios_build_type_41_table(errp);
