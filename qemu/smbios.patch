+} QEMU_PACKED;
+
+static void smbios_build_type_26_table(unsigned instance, const char *description,
+                                       uint8_t location_and_status)
+{
+    SMBIOS_BUILD_TABLE_PRE(26, T26_BASE + instance, true);
+    SMBIOS_TABLE_SET_STR(26, description, description);
+    t->location_and_status = location_and_status;
+    t->max_value = cpu_to_le16(instance == 0 ? 2000 : 0x8000);
+    t->min_value = cpu_to_le16(instance == 0 ? 0 : 0x8000);
+    t->resolution = cpu_to_le16(instance == 0 ? 10 : 0x8000);
+    t->tolerance = cpu_to_le16(instance == 0 ? 50 : 0x8000);
+    t->accuracy = cpu_to_le16(instance == 0 ? 100 : 0x8000);
+    t->oem_defined = 0;
+    t->nominal_value = cpu_to_le16(instance == 0 ? 1200 : 0x8000);
+    SMBIOS_BUILD_TABLE_POST;
+}
+
+static void smbios_build_type_27_table(unsigned instance, const char *description,
+                                       uint8_t device_type_and_status)
+{
+    SMBIOS_BUILD_TABLE_PRE(27, T27_BASE + instance, true);
+    t->temperature_probe_handle = cpu_to_le16(T28_BASE + instance);
+    t->device_type_and_status = device_type_and_status;
+    t->cooling_unit_group = 1;
+    t->OEM_defined = 0;
+    t->nominal_speed = cpu_to_le16(1500);
+    SMBIOS_TABLE_SET_STR(27, description, description);
+    SMBIOS_BUILD_TABLE_POST;
+}
+
+static void smbios_build_type_28_table(unsigned instance, const char *description,
+                                       uint8_t location_and_status)
+{
+    SMBIOS_BUILD_TABLE_PRE(28, T28_BASE + instance, true);
+    SMBIOS_TABLE_SET_STR(28, description, description);
+    t->location_and_status = location_and_status;
+    t->maximum_value = cpu_to_le16(1000);
+    t->minimum_value = cpu_to_le16(0);
+    t->resolution = cpu_to_le16(1);
+    t->tolerance = cpu_to_le16(10);
+    t->accuracy = cpu_to_le16(100);
+    t->OEM_defined = 0;
+    t->nominal_value = cpu_to_le16(450);
+    SMBIOS_BUILD_TABLE_POST;
+}
+
