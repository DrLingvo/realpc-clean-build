+struct smbios_type_26 {
+    struct smbios_structure_header header;
+    uint8_t description;
+    uint8_t location_and_status;
+    uint16_t max_value;
+    uint16_t min_value;
+    uint16_t resolution;
+    uint16_t tolerance;
+    uint16_t accuracy;
